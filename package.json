{
  "name": "naspeclinic",
  "private": true,
  "version": "0.1.0",
  "description": "Plataforma de salud ocupacional Naspeclinic: web, app móvil y API",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev:api": "npm run dev -w @naspeclinic/api",
    "seed": "npm run seed -w @naspeclinic/api",
    "test": "npm test -w @naspeclinic/api",
    "typecheck": "npm run typecheck -w @naspeclinic/api"
  },
  "engines": {
    "node": ">=20"
  }
}
