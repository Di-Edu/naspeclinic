# Copiar como .env y completar. Nunca subir .env al repositorio.
NODE_ENV=development
PORT=4000

# PostgreSQL (Railway). Si se deja vacío, se usa PGlite local en ./.data
DATABASE_URL=

# Secretos: genere cada uno con
# node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=
ENCRYPTION_KEY=
HMAC_KEY=

# Dominios autorizados del frontend (separados por coma)
CORS_ORIGINS=http://localhost:5173

# Correo (SMTP). Vacío = modo simulado, solo registra en consola
SMTP_URL=
SMTP_FROM=Naspeclinic <no-responder@naspeclinic.cl>

# Logo para el PDF del reporte (opcional)
LOGO_PATH=
